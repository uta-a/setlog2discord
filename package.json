{
  "name": "setlog-webapp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "start": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local bot/main.ts",
    "dev": "tsx watch --env-file-if-exists=.env --env-file-if-exists=.env.local bot/main.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "discord.js": "14.28.1",
    "tsx": "^4.23.15",
    "ws": "8.22.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/ws": "8.18.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
